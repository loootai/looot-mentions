# Agent token for a real run (not needed for --demo or --dry-run). Create it in your looot settings, Agent tokens.
LOOOT_TOKEN=
# Admin password for the web UI: every page and API route except /login, /api/auth/* and /api/health. 12 characters or more.
# Required outside the demo. Without it the admin pages stay closed and /login shows a setup page. The CLI does not read it.
MENTIONS_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# MENTIONS_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# MENTIONS_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# MENTIONS_COOKIE_SECURE=
# Optional: config file the web UI reads its cap per run from (maxSpendPerRunUsd). Default mentions.yaml
# MENTIONS_CONFIG=
# Optional: override the looot API base URL. Default https://api.looot.ai
# LOOOT_API_URL=
# Optional: where the web UI reads and writes mentions. Default ./data/mentions.json
# MENTIONS_DATA=data/mentions.json
# Optional. Starting daily and monthly budget in dollars, defaults 10 and 50. The owner changes them on the Costs page.
# LOOOT_MENTIONS_DAILY_USD=
# LOOOT_MENTIONS_MONTHLY_USD=
# Optional. Where the budget file (budget.json) lives. Default: ./.looot-data. The budget file needs one instance on a persistent disk.
# LOOOT_MENTIONS_DATA_DIR=
